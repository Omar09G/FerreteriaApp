# ─────────────────────────────────────────────────────────────
# Frontend — Ferretería "El Tornillo Feliz" (PLANTILLA)
# Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL del backend para el proxy de Vite en desarrollo.
VITE_API_PROXY=http://localhost:8080

# Solo dev: si true, axios llama directo al backend sin pasar por el proxy.
VITE_DEV_SIN_PROXY=false

# (Opcional) URL absoluta del backend; tiene prioridad sobre VITE_API_PROXY.
# VITE_API_URL=http://localhost:8080/api/v1

# ── Sesión ───────────────────────────────────────────────────
# Tiempo (ms) sin actividad antes de logout automático. 0 = desactivado.
# 15 min = 900000   30 min = 1800000   1 hora = 3600000
VITE_SESSION_TIMEOUT_MS=900000

# ── Resiliencia HTTP ─────────────────────────────────────────
# Reintentos automáticos ante fallos de red / 5xx. 0 = desactivado.
VITE_API_MAX_RETRIES=3

# Backoff inicial (ms) entre reintentos (se duplica en cada uno).
VITE_API_RETRY_BACKOFF_MS=1000

# Timeout por request individual (ms). Evita cuelgues indefinidos.
VITE_API_TIMEOUT_MS=30000
