## Configuración de la base de datos PostgreSQL
PG_HOST=localhost
PG_PORT=6432
PG_USER=ferreteria_app
PG_PASSWORD=CAMBIAR_dev_only
PG_DATABASE=ferreteria

# Configuración de la aplicación
REQUEST_ID_MODE=GENERATE
# Configuración de JWT — PASO 1: sin default, debe venir del entorno. Genera con: openssl rand -base64 48
JWT_SECRET=                         # p.ej. sMuJeQ1prwGDL5SCu7tpS4FtCcIvbJ8Rw6cciudScgc=
JWT_PREVIOUS_SECRET=                # BACK-SEC-033: viejo secret durante rotacion (opcional)
ACCESS_MINUTES=15
REFRESH_HOURS=8

# MinIO (fotos de entidades). ENDPOINT = red interna del backend,
# PUBLIC_URL = lo que se guarda en foto_url y resuelve el browser.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ferreteria-fotos
MINIO_DOCS_BUCKET=ferreteria-tickets
MINIO_MAX_MB=5

# Por defecto, el servidor se ejecutará en el puerto 8080. Puedes cambiarlo según tus necesidades.

SERVER_PORT=8080

# CORS (PLAN M7) - restringido por origen; "*" permitido solo sin credenciales.
# Credentials=true obligatorio: auth viaja en cookies HttpOnly con withCredentials.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining,Retry-After
CORS_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true

# Rate limit bucket4j por controller (PLAN M7)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCOPE_BY_USER=true
RATE_LIMIT_CACHE_MAX_SIZE=200000
RATE_LIMIT_CACHE_TTL_MINUTES=30
RATE_LIMIT_DEFAULT_CAPACITY=300
RATE_LIMIT_DEFAULT_REFILL=10
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL=1
RATE_LIMIT_CATALOGO_CAPACITY=1200
RATE_LIMIT_CATALOGO_REFILL=40

# Segundo factor OTP (defaults: TTL 5 min, 5 intentos, reenvío 60 s).
OTP_TTL_MINUTOS=5
OTP_MAX_INTENTOS=5
OTP_REENVIO_SEGUNDOS=60

# Login con Google (redirect). Crea el par en Google Cloud Console con
# redirect URI = GOOGLE_REDIRECT_URI. Sin esto, el botón Google falla.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback
GOOGLE_FRONTEND_CALLBACK=http://localhost:5173/auth/callback

# Recordatorio diario de cuentas por pagar (vencidas + pendientes) por
# correo a GERENTES y ADMINISTRADORES, 09:00 por defecto. Activo salvo
# apagado explícito; requiere APP_NOTIF_ENABLED=true.
CUENTAS_PAGAR_CRON=0 0 9 * * *
CUENTAS_PAGAR_ZONA=America/Mexico_City
CUENTAS_PAGAR_JOB_ENABLED=true

# Informe diario del dashboard (KPIs + cierre) por correo y WhatsApp a
# GERENTES y ADMINISTRADORES con contacto asignado.
# Cron Spring (seg min hora día mes semana): 1 vez al día, 07:00 por defecto.
INFORME_DASHBOARD_CRON=0 0 7 * * *
INFORME_DASHBOARD_ZONA=America/Mexico_City
# false = solo botón manual; true = además JOB diario automático.
# Requiere APP_NOTIF_ENABLED=true (ver deploy/.env.example).
INFORME_DASHBOARD_JOB_ENABLED=false
