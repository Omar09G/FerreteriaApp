      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ferreteria_frontend_navigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ferreteria_frontend_navigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Frontend: errores JS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 32, "w": 6, "h": 8 },
