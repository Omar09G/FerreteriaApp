# ============================================================================
# .env.example — Ferretería "El Tornillo Feliz" · TODOS los servicios
# ----------------------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env
#
# Este archivo es la FUENTE ÚNICA de secretos en runtime para:
#   - Postgres + PgBouncer
#   - Backend Spring Boot (Spring lee las env vars del contenedor)
#
# El frontend NO usa este archivo: Vite lee `ferreteriaFront/.env` en BUILD
# time y bakea las VITE_* en el bundle. El .env del front vive en su propio
# proyecto (ver ferreteriaFront/.env.example).
# ============================================================================

# ─── Postgres (servicio postgres-primary) ──────────────────────────────────
# Password del usuario admin (postgres). Necesario para crear roles y DB.
POSTGRES_ADMIN_PASSWORD=cambia_admin_seguro
# Password del usuario de aplicación (ferreteria_app). Lo usa el backend.
POSTGRES_APP_PASSWORD=cambia_app_seguro
# Password del usuario de réplica (solo si activas el perfil `replica`).
REPLICATION_PASSWORD=cambia_replica_seguro
# Nombre del host primario desde la perspectiva del contenedor réplica
# (normalmente NO necesitas cambiarlo).
PRIMARY_HOST=postgres-primary

# ─── Backend (servicio ferreteria-backend) ─────────────────────────────────
# Conexión a BD vía PgBouncer. NO se cambia en docker-compose.
PG_HOST=pgbouncer
PG_PORT=6432
PG_DATABASE=ferreteria
PG_USER=ferreteria_app
PG_PASSWORD=cambia_app_seguro

# Zona horaria
ZONA=America/Mexico_City
SERVER_PORT=8080

# ─── JWT (debe ser ≥ 256 bits / 32 bytes en base64) ─────────────────────────
# Genera uno nuevo para producción con:
#   openssl rand -base64 48
JWT_SECRET=sMuJeQ1prwGDL5SCu7tpS4FtCcIvbJ8Rw6cciudScgc=
ACCESS_MINUTES=480       # 8 h (access token)
REFRESH_HOURS=72         # 3 días (refresh token)

# ─── CORS ──────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. En docker el front vive en
# localhost:8080 (nginx expone 80). Si despliegas detrás de un reverse proxy
# público HTTPS, cámbialo a tu dominio.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining,Retry-After
CORS_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true

# ─── Cookies HttpOnly (auth) ────────────────────────────────────────────────
# En docker compose el navegador accede por http://localhost:8080 (sin TLS),
# así que Secure=false. En prod sobre HTTPS, AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_REFRESH_NAME=rt
AUTH_COOKIE_ACCESS_NAME=at

# ─── Rate limit ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCOPE_BY_USER=true
RATE_LIMIT_CACHE_MAX_SIZE=200000
RATE_LIMIT_CACHE_TTL_MINUTES=30
RATE_LIMIT_DEFAULT_CAPACITY=300
RATE_LIMIT_DEFAULT_REFILL=10
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL=1
RATE_LIMIT_CATALOGO_CAPACITY=1200
RATE_LIMIT_CATALOGO_REFILL=40

# ─── Request ID ────────────────────────────────────────────────────────────
REQUEST_ID_MODE=GENERATE

# ─── Entorno de ejecución (opcional, defensa adicional) ────────────────────
# Si se setea explícitamente a "prod", el DemoGuard del backend abortará el
# arranque si detecta el perfil "demo" activo. Útil para fail-fast en CI.
# Valores: dev | test | staging | prod (vacío = confiar en el perfil Spring)
# FERRETERIA_ENV=prod

# ─── Recursos de Postgres (límites del contenedor) ─────────────────────────
PG_SHM_SIZE=256mb
PG_MEM_LIMIT=2g
PG_CPUS=2.0

# ─── Imágenes (opcional: sobreescribe versiones) ───────────────────────────
PG_IMAGE=postgres:17-alpine
PGBOUNCER_IMAGE=pgbouncer/pgbouncer:latest

# ─── Observabilidad (OpenTelemetry + Prometheus + Grafana) ─────────────────
# Activar telemetría del backend Java (OTel Java agent). false = noop.
OTEL_SDK_DISABLED=false
# Imagen del collector. Contrib incluye receivers: otlp, prometheus, etc.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
# Puertos expuestos al host para el collector (los internos los usa Docker DNS)
OTEL_GRPC_PORT=4317       # backend → otel (gRPC)
OTEL_HTTP_PORT=4318       # browser → otel (HTTP, CORS)
OTEL_PROM_PORT=8889       # Prometheus scrapea aquí
# postgres-exporter (sidecar que lee pg_stat_* y expone Prometheus)
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0
POSTGRES_EXPORTER_PORT=9187
# Prometheus
PROMETHEUS_IMAGE=prom/prometheus:v2.55.0
PROMETHEUS_PORT=9090
# Grafana
GRAFANA_IMAGE=grafana/grafana:11.3.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia_grafana

# ─── Telemetría del frontend (bakeado en build time de la imagen) ─────────
# En Docker prod se setea true por defecto (en .env del repo es false para dev).
# El endpoint es la URL del OTel Collector vista por el BROWSER, no por la red
# Docker (el collector expone :4318 en localhost del host).
VITE_OTEL_ENABLED=true
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VITE_APP_VERSION=0.0.0
