# ============================================================
# Ferretería · Configuración de despliegue
# Copiar a .env y ajustar antes de arrancar:  cp .env.example .env
# ============================================================

# --- Credenciales (OBLIGATORIO cambiar en cualquier entorno real) ---
POSTGRES_ADMIN_PASSWORD=CambiaAdmin2026!
POSTGRES_APP_PASSWORD=CambiaApp2026!
REPLICATION_PASSWORD=CambiaReplica2026!

# --- Imágenes ---
PG_IMAGE=postgres:17-alpine
PGBOUNCER_IMAGE=pgbouncer/pgbouncer:latest  # fijar a un tag/digest concreto en producción

# --- Recursos (escalamiento vertical del contenedor primario) ---
PG_MEM_LIMIT=2g
PG_CPUS=2.0
PG_SHM_SIZE=256mb

# --- Réplica de lectura (podman compose --profile replica up -d) ---
PRIMARY_HOST=postgres-primary
